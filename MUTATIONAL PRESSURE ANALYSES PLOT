#graficar
       library(ggplot2)
       
       breaks_vals <- c(0.0,0.25, 0.50, 0.75, 1.0)
       tick_len <- 0.02  # largo de las marquitas (ajustable)
       
       # Data frames para las marcas (ticks) del eje X e Y
       ticks_x <- data.frame(x = breaks_vals, y0 = 0.5 - tick_len, y1 = 0.5 + tick_len)
       ticks_y <- data.frame(y = breaks_vals, x0 = 0.5 - tick_len, x1 = 0.5 + tick_len)
       
       pr2_plot <- ggplot() +
         # Líneas de los ejes cruzados en el centro, ahora de 0 a 1
         geom_segment(aes(x = 0, xend = 1, y = 0.5, yend = 0.5), color = "black", linewidth = 0.6) +
         geom_segment(aes(x = 0.5, xend = 0.5, y = 0, yend = 1), color = "black", linewidth = 0.6) +
         # Ticks (marcas perpendiculares) en cada número del eje X
         geom_segment(data = ticks_x, aes(x = x, xend = x, y = y0, yend = y1), 
                      color = "black", linewidth = 0.5) +
         # Ticks en cada número del eje Y
         geom_segment(data = ticks_y, aes(x = x0, xend = x1, y = y, yend = y), 
                      color = "black", linewidth = 0.5) +
         # Números del eje X
         annotate("text", x = breaks_vals, y = 0.5 - tick_len - 0.03, 
                  label = breaks_vals, size = 3.2, vjust = 1) +
         # Números del eje Y
         annotate("text", x = 0.5 - tick_len - 0.03, y = breaks_vals, 
                  label = breaks_vals, size = 3.2, hjust = 1) +
         # Puntos de los organismos
         geom_point(data = Met_ENC, 
                    aes(x = G3_ratio, y = A3_ratio, color = gene, shape = gene),
                    size = 2.5, alpha = 0.7) +
         # Centroides
         geom_point(data = centroides, 
                    aes(x = G3_ratio_mean, y = A3_ratio_mean, color = gene),
                    size = 6, shape = 8, stroke = 1.5) +
         scale_color_manual(values = c("#756bb1", "#1c9099", "#31a354", "#e6550d")) +
         scale_shape_manual(values = c(16, 17, 15, 18)) +
         scale_x_continuous(limits = c(0, 1)) +
         scale_y_continuous(limits = c(0, 1)) +
         coord_fixed() +
         labs(title = "PR2-plot: Cysteine pathway",
              x = "G3/(G3+C3)", y = "A3/(A3+U3)",
              color = "Gene", shape = "Gene") +
         theme_void(base_size = 11) +
         theme(
           plot.title = element_text(face = "bold", hjust = 0.5),
           axis.title.x = element_text(face = "bold", margin = margin(t = 10)),
           axis.title.y = element_text(face = "bold", angle = 90, margin = margin(r = 10)),
           plot.background = element_rect(fill = "white", color = NA),
           legend.title = element_text(face = "bold")
         )
       
       pr2_plot
