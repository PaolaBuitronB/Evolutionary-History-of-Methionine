library(ggplot2)
library(dplyr)
library(ggrepel)

# 1. Verificar tipos de datos - PASO CRÍTICO
str(Met_ENC)

# Forzar conversión numérica por si vienen como texto
Met_ENC$GC3s <- as.numeric(Met_ENC$GC3s)
Met_ENC$ENC  <- as.numeric(Met_ENC$ENC)

# Verificar rangos reales
range(Met_ENC$GC3s, na.rm = TRUE)
range(Met_ENC$ENC, na.rm = TRUE)

# 2. Función de la curva esperada de Wright (1990)
#    Tu GC3s está en escala 0-100, así que la función divide entre 100
wright_curve <- function(gc3s) {
  gc3s <- gc3s / 100
  2 + gc3s + 29 / (gc3s^2 + (1 - gc3s)^2)
}

# 3. Generar puntos para la curva (UNA SOLA VEZ, escala 0-100)
curve_df <- data.frame(GC3s = seq(0, 100, by = 1))
curve_df$Nc_esperado <- wright_curve(curve_df$GC3s)

# 4. Armar el gráfico
enc_plot <- ggplot() +
  geom_line(data = curve_df, aes(x = GC3s, y = Nc_esperado),
            color = "#BDBDBD", linewidth = 1, linetype = "solid") +
  geom_point(data = Met_ENC, 
             aes(x = GC3s, y = ENC, color = gene, shape = gene),
             size = 3, alpha = 0.75) +
  scale_color_manual(values = c( "#3D6FB6", "#C8673F")) +
  scale_shape_manual(values = c(16, 17, 15, 18)) +
  scale_y_continuous(limits = c(20, 100), breaks = seq(20, 100, 10)) +
  scale_x_continuous(limits = c(0, 100)) +
  labs(
    title = "ENC-plot: TRANSULFURATION PATHWAY",
    x = "GC3s (%)",
    y = "ENC",
    color = "Gene",
    shape = "Gene"
  ) +
  theme_minimal(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold"),
    legend.position = "right"
  )


enc_plot

