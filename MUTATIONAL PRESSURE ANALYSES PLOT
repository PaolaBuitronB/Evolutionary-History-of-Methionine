## Cálculo de la pendiente
modelo <- lm(GC12 ~ GC3, data = Met_ENC)
subtitulo <- sprintf("Pendiente = %.3f   |   R² = %.3f",
                     coef(modelo)[2], summary(modelo)$r.squared)

## NEUTRALIDAD GENERAL REGRESION LINEAL
neutrality_plot_general <- ggplot(Met_ENC, aes(x = GC3, y = GC12)) +
  geom_point(aes(color = gene, shape = gene), size = 3, alpha = 0.85) +
  geom_smooth(method = "lm", se = TRUE, color = "blue", linewidth = 0.8) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "black") +
  scale_color_manual(values = c("#662506", "#ec7014", "#225ea8", "#969696")) +
  scale_shape_manual(values = c(16, 17, 15, 18)) +
  labs(
    title = "Neutrality plot: GC12 vs GC3",
    subtitle = subtitulo,
    x = "GC3 (%)",
    y = "GC12 (%)",
    color = "Gen",
    shape = "Gen"
  ) +
  theme_minimal(base_size = 11) +
  theme(plot.title = element_text(face = "bold"))

neutrality_plot_general



