# =========================================================
# Lollipop plot: dN/dS global por gene (Tabela 2, Datamonkey/HyPhy)
# =========================================================

library(ggplot2)
library(dplyr)
library(forcats)

# --- 1. Dados da Tabela 2 -------------------------------------------------
df <- data.frame(
  gene   = c("CBS", "CGL", "CS", "SAT", "CD1", "CD2"),
  dNdS   = c( 0.123, 0.0911, 0.106, 0.810, 0.115, 0.137),
  modulo = c("Transulfuration", "Transulfuration",
             "de novo", "de novo",
             "Mobilization Fe-S", "Mobilization Fe-S")
)

# Ordena os genes pelo valor de dN/dS (do menor para o maior restrição -> relaxamento)
df <- df %>%
  mutate(gene = fct_reorder(gene, dNdS))

# --- 2. Paleta por módulo (ajuste as cores como preferir) ------------------
cores_modulo <- c(
  "Transulfuration"          = "#addd8e",
  "de novo"                  = "#0570b0",
  "Mobilization Fe-S"          = "#a63603"
)

# --- 3. Gráfico -------------------------------------------------------------
p <- ggplot(df, aes(x = dNdS, y = gene, color = modulo)) +
  # linha de referência: neutralidade (dN/dS = 1)
  geom_vline(xintercept = 1, linetype = "dashed", color = "black", linewidth = 0.8) +
  # "palito" do lollipop
  geom_segment(aes(x = 0, xend = dNdS, y = gene, yend = gene), linewidth = 0.9) +
  # "bolinha" do lollipop
  geom_point(size = 5) +
  scale_color_manual(values = cores_modulo, name = "Functional Module") +
  labs(
    x = "dN/dS global (\u03C9)",
    y = NULL
  ) +
  theme_minimal(base_size = 15) +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major.y = element_blank(),
    legend.position = "right",
    plot.title = element_text(face = "bold")
  )

print(p)

# --- 4. Salvar em alta resolução --------------------------------------------
ggsave("lollipop_dNdS.png", plot = p, width = 8, height = 5.5, dpi = 300)
ggsave("lollipop_dNdS.pdf", plot = p, width = 8, height = 5.5)
